{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "nexora-news-website-development-9ve.vercel.app" }
      ],
      "destination": "https://www.nexoranews.uk/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/rss.xml", "destination": "/api/rss" },
    {
      "source": "/article.html",
      "has": [
        { "type": "query", "key": "slug", "value": "(?<slug>.+)" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|whatsapp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|Googlebot|Google-InspectionTool|AdsBot-Google|bingbot|BingPreview|Applebot|DuckDuckBot).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    }
  ]
}